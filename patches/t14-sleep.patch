+// T14G4 sleep build: XE-FWSNAP (ported from the X1 Carbon G11 fork).
+// Read the firmware-trained TRANS_DDI_FUNC_CTL_A and PP_CONTROL once, before anything writes them, and
+// reuse those values instead of the XPS literals (0x8A000106 = 4 lanes; T14 trains 2 lanes).
+// Override: ngreenddifunc=0xVALUE.
+static uint32_t gXeFwDdiFuncA = 0;   // 0x60400
+static uint32_t gXeFwPpControl = 0;  // 0xC7204
+static void xeFwSnapshot() {
+	if (!NGreen::callback || NGreen::callback->getIsRealTGL()) return;
+	if (!gXeFwDdiFuncA) {
+		uint32_t v = NGreen::callback->readReg32(0x60400);
+		if (v & 0x80000000u) {
+			gXeFwDdiFuncA = v;
+			SYSLOG("ngreen", "XE-FWSNAP: TRANS_DDI_FUNC_CTL_A=0x%x (lanes=%u)", v, ((v >> 1) & 0x7u) + 1);
+		}
+	}
+	if (!gXeFwPpControl) {
+		uint32_t v = NGreen::callback->readReg32(0xC7204);
+		if (v) {
+			gXeFwPpControl = v;
+			SYSLOG("ngreen", "XE-FWSNAP: PP_CONTROL=0x%x", v);
+		}
+	}
+}
+static uint32_t xeDdiFuncA() {
+	static int ddiArg = -1; static uint32_t ddiOv = 0;
+	if (ddiArg < 0) { ddiArg = 0; if (PE_parse_boot_argn("ngreenddifunc", &ddiOv, sizeof(ddiOv)) && ddiOv) ddiArg = 1; }
+	xeFwSnapshot();
+	return ddiArg == 1 ? ddiOv : (gXeFwDdiFuncA ? gXeFwDdiFuncA : 0x8A000106u);
+}
